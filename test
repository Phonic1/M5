<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Parlour & Poison — Printable Murder Mystery Party Kits</title>
<style>
  /* ---- Fonts (graceful fallback if CDN blocked) ---- */
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;0,900;1,500&family=Spectral:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;600&display=swap');

  :root{
    --ink:#14171F;        /* deep ink navy   */
    --ink-2:#1B1F2A;      /* raised panel    */
    --oxblood:#7C2A2A;    /* oxblood accent  */
    --oxblood-lit:#9A3636;
    --brass:#C9A24B;      /* brass keylight  */
    --brass-soft:#D9B96E;
    --bone:#EDE7D8;       /* paper / text    */
    --bone-dim:#C8C2B4;
    --smoke:#8A92A0;      /* muted utility   */
    --line:#2A2F3B;       /* hairline        */
    --display:'Playfair Display', Georgia, serif;
    --body:'Spectral', Georgia, serif;
    --mono:'JetBrains Mono', ui-monospace, 'Courier New', monospace;
    color-scheme: dark;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0; background:var(--ink); color:var(--bone);
    font-family:var(--body); font-size:18px; line-height:1.6;
    -webkit-font-smoothing:antialiased;
    background-image:
      radial-gradient(1200px 700px at 78% -8%, rgba(201,162,75,.10), transparent 60%),
      radial-gradient(900px 600px at 8% 12%, rgba(124,42,42,.14), transparent 60%);
  }
  a{color:inherit;}
  ::selection{background:var(--oxblood); color:var(--bone);}

  .wrap{max-width:1120px; margin:0 auto; padding:0 24px;}

  /* ---- Top bar ---- */
  header.bar{
    position:sticky; top:0; z-index:40;
    background:rgba(20,23,31,.82); backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .bar-inner{display:flex; align-items:center; justify-content:space-between; height:66px;}
  .brand{font-family:var(--display); font-weight:900; letter-spacing:.02em; font-size:21px;}
  .brand .amp{color:var(--brass);}
  nav.links{display:flex; gap:26px; font-family:var(--mono); font-size:12.5px; letter-spacing:.08em; text-transform:uppercase;}
  nav.links a{color:var(--bone-dim); text-decoration:none; padding:6px 2px; border-bottom:1px solid transparent;}
  nav.links a:hover{color:var(--bone); border-color:var(--brass);}
  @media (max-width:720px){ nav.links{display:none;} }

  /* ---- Hero ---- */
  .hero{position:relative; padding:96px 0 84px; overflow:hidden;}
  .hero .eyebrow{
    font-family:var(--mono); font-size:12.5px; letter-spacing:.32em; text-transform:uppercase;
    color:var(--brass); margin:0 0 22px;
  }
  .hero h1{
    font-family:var(--display); font-weight:900; font-size:clamp(40px, 7vw, 80px);
    line-height:1.02; margin:0 0 24px; letter-spacing:-.01em;
  }
  .hero h1 em{font-style:italic; color:var(--brass-soft);}
  .hero p.lede{font-size:clamp(18px,2.1vw,21px); color:var(--bone-dim); max-width:46ch; margin:0 0 36px;}
  .cta-row{display:flex; gap:16px; flex-wrap:wrap; align-items:center;}
  .btn{
    display:inline-flex; align-items:center; gap:10px;
    font-family:var(--mono); font-size:13px; letter-spacing:.1em; text-transform:uppercase;
    text-decoration:none; padding:14px 24px; border:1px solid var(--brass);
    color:var(--ink); background:var(--brass); cursor:pointer;
    transition:transform .15s ease, background .2s ease;
  }
  .btn:hover{background:var(--brass-soft); transform:translateY(-2px);}
  .btn.ghost{background:transparent; color:var(--bone); border-color:var(--line);}
  .btn.ghost:hover{border-color:var(--brass); background:transparent;}
  .btn:focus-visible{outline:2px solid var(--bone); outline-offset:3px;}

  /* flickering keylight behind hero word */
  .keylight{
    position:absolute; right:-6%; top:8%; width:min(560px,52vw); height:min(560px,52vw);
    background:radial-gradient(circle at 50% 50%, rgba(201,162,75,.30), rgba(201,162,75,0) 64%);
    filter:blur(6px); pointer-events:none; z-index:0; animation:flicker 5.5s infinite ease-in-out;
  }
  .hero .wrap{position:relative; z-index:1;}
  @keyframes flicker{
    0%,100%{opacity:.9;} 42%{opacity:.62;} 46%{opacity:.95;}
    60%{opacity:.55;} 64%{opacity:.88;} 80%{opacity:.7;}
  }

  /* ---- Section scaffolding ---- */
  section{padding:74px 0;}
  .sec-head{display:flex; align-items:baseline; gap:18px; margin-bottom:40px;}
  .sec-head .tag{font-family:var(--mono); font-size:12px; letter-spacing:.2em; color:var(--brass); white-space:nowrap;}
  .sec-head h2{font-family:var(--display); font-weight:700; font-size:clamp(28px,4vw,40px); margin:0;}
  .sec-head .rule{flex:1; height:1px; background:var(--line);}

  /* ---- Case-file product cards ---- */
  .grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(330px,1fr)); gap:26px;}
  .file{
    position:relative; background:var(--ink-2); border:1px solid var(--line);
    padding:26px 26px 24px; display:flex; flex-direction:column; min-height:340px;
    transition:border-color .25s ease, transform .25s ease;
  }
  .file:hover{border-color:var(--brass); transform:translateY(-4px);}
  .file .casno{font-family:var(--mono); font-size:11.5px; letter-spacing:.16em; color:var(--smoke); text-transform:uppercase;}
  .file h3{font-family:var(--display); font-weight:700; font-size:26px; line-height:1.12; margin:14px 0 6px;}
  .file .sub{font-style:italic; color:var(--bone-dim); margin:0 0 18px; font-size:16px;}
  .stats{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px;}
  .chip{font-family:var(--mono); font-size:11px; letter-spacing:.06em; color:var(--bone-dim);
    border:1px solid var(--line); padding:5px 10px; text-transform:uppercase;}
  /* redaction bar: wipes to reveal tagline on hover/focus */
  .redact{position:relative; margin:auto 0 20px; padding:10px 0; font-size:16px; color:var(--bone-dim);}
  .redact span{position:relative; z-index:1;}
  .redact::before{
    content:""; position:absolute; inset:6px -4px; background:var(--ink);
    border-left:3px solid var(--oxblood); transform-origin:left center;
    transition:transform .45s cubic-bezier(.6,0,.2,1); z-index:2;
  }
  .file:hover .redact::before, .file:focus-within .redact::before{transform:scaleX(0);}
  .file .buy{
    display:inline-flex; align-items:center; justify-content:center; gap:10px;
    font-family:var(--mono); font-size:12.5px; letter-spacing:.1em; text-transform:uppercase;
    text-decoration:none; padding:13px 18px; border:1px solid var(--brass);
    color:var(--brass); background:transparent; transition:background .2s ease,color .2s ease;
  }
  .file .buy:hover{background:var(--brass); color:var(--ink);}
  .file .buy:focus-visible{outline:2px solid var(--bone); outline-offset:2px;}
  /* corner stamp */
  .stamp{
    position:absolute; top:18px; right:18px; font-family:var(--mono); font-size:9.5px;
    letter-spacing:.12em; color:var(--oxblood-lit); border:1.5px solid var(--oxblood);
    padding:4px 7px; transform:rotate(7deg); opacity:.85; text-transform:uppercase;
  }

  /* ---- How it works ---- */
  .steps{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:30px;}
  .step .n{font-family:var(--mono); font-size:13px; color:var(--brass); letter-spacing:.15em;}
  .step h4{font-family:var(--display); font-weight:700; font-size:21px; margin:10px 0 8px;}
  .step p{margin:0; color:var(--bone-dim); font-size:16.5px;}

  /* ---- Quote / promise band ---- */
  .band{border-top:1px solid var(--line); border-bottom:1px solid var(--line); background:var(--ink-2);}
  .band blockquote{
    font-family:var(--display); font-style:italic; font-weight:500;
    font-size:clamp(24px,3.6vw,38px); line-height:1.3; margin:0; max-width:24ch; text-align:center;
    margin-inline:auto;
  }
  .band blockquote .by{display:block; font-family:var(--mono); font-style:normal; font-size:12px;
    letter-spacing:.2em; color:var(--brass); margin-top:22px; text-transform:uppercase;}

  /* ---- Cover image on cards ---- */
  .file .cover{
    margin:-26px -26px 18px; aspect-ratio:1/1; overflow:hidden;
    border-bottom:1px solid var(--line); background:var(--ink);
  }
  .file .cover img{width:100%; height:100%; object-fit:cover; display:block;
    transition:transform .5s ease; }
  .file:hover .cover img{transform:scale(1.04);}
  /* text-only card keeps taller body; cover cards have image up top */
  .file.has-cover{padding-top:26px;}

  /* ---- Footer ---- */
  footer{border-top:1px solid var(--line); padding:48px 0 60px; color:var(--smoke);}
  .foot-inner{display:flex; justify-content:space-between; gap:24px; flex-wrap:wrap; align-items:center;}
  footer .brand{font-size:18px;}
  footer .fine{font-family:var(--mono); font-size:11.5px; letter-spacing:.06em;}

  @media (prefers-reduced-motion:reduce){
    *{animation:none !important; transition:none !important;}
    html{scroll-behavior:auto;}
  }
</style>
</head>
